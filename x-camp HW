import sys
n,m=map(int,input().split())
matrix=[input().strip() for _ in range(n)]
dx=[-1,1,0,0]
dy=[0,0,-1,1]
vis=[[False]*m for _ in range(n)]
max_treasure=-1
def isvalid(x,y):
    return 0<=x<n and 0<=y<m and vis[x][y]==False and matrix[x][y]!='#'
def dfs(x,y,current_value): 
    next_value=0
    global max_treasure 
    if (x,y)==(n-1,m-1):
        max_treasure=max(max_treasure,current_value)
        return
    for i in range(4):
        nx,ny=x+dx[i],y+dy[i]
        if isvalid(nx,ny):
            next_value=current_value+(int(matrix[nx][ny]) if matrix[nx][ny].isdigit() else 0)
            vis[nx][ny]=True
            dfs(nx,ny,next_value)
            vis[nx][ny]=False
vis[0][0]=True
start_value=int(matrix[0][0] if matrix[0][0].isdigit() else 0)
dfs(0,0,start_value)
print(max_treasure)